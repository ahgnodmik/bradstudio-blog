<div id='footer'>
  <div class='outer-wrapper'>
    <p>&#169; <data:blog.title/> | 본 사이트의 정보는 참고용이며 실제 신청은 공식 사이트에서 확인하세요.</p>
  </div>
</div>

<script>
//<![CDATA[
document.addEventListener('DOMContentLoaded', function () {
  // 서랍 열기·닫기 (배경 클릭, 닫기 버튼, Esc)
  var drawerBtn = document.getElementById('drawer-open');
  var setDrawer = function (open) {
    document.body.classList.toggle('drawer-open', open);
    if (drawerBtn) drawerBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) { var q = document.querySelector('#side-drawer input[name=q]'); if (q) q.focus(); }
  };
  if (drawerBtn) drawerBtn.addEventListener('click', function () { setDrawer(true); });
  ['drawer-close', 'drawer-backdrop'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('click', function () { setDrawer(false); });
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setDrawer(false); });

  // 카드 요약에서 교차 발행 안내 문장을 빼고 본문 첫 문장부터 보이게
  var PREFIX = /^\s*이 글은 bradstudio\.xyz에 먼저 게재된 글입니다\.\s*최신 업데이트는 원문에서 확인하세요\.\s*/;
  document.querySelectorAll('.card-snippet').forEach(function (p) {
    p.textContent = p.textContent.replace(PREFIX, '');
  });

  // 더 보기: 다음 쪽을 가져와 카드만 이어 붙인다. 실패하면 기존 이전/최신 글 버튼으로 돌아간다.
  var grid = document.getElementById('post-grid');
  var older = document.getElementById('older-link');
  var moreWrap = document.getElementById('more-wrap');
  var moreBtn = document.getElementById('load-more');
  if (grid && older && moreWrap && moreBtn) {
    var pager = document.querySelector('.blog-pager');
    var next = older.href;
    moreWrap.style.display = 'block';
    if (pager) pager.style.display = 'none';
    moreBtn.addEventListener('click', function () {
      if (!next) return;
      moreBtn.disabled = true;
      moreBtn.textContent = '불러오는 중…';
      fetch(next).then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        doc.querySelectorAll('#post-grid .post-card').forEach(function (card) {
          var p = card.querySelector('.card-snippet');
          if (p) p.textContent = p.textContent.replace(PREFIX, '');
          grid.appendChild(document.importNode(card, true));
        });
        var n = doc.getElementById('older-link');
        next = n ? n.href : null;
        moreBtn.disabled = false;
        moreBtn.textContent = '더 보기';
        if (!next) moreWrap.style.display = 'none';
      }).catch(function () {
        moreWrap.style.display = 'none';
        if (pager) pager.style.display = '';
      });
    });
  }

  // 글 목록 중간 광고: 4번째 카드 뒤, 광고 코드가 들어 있을 때만 표시 (빈 '광고' 칸 방지)
  var cards = document.querySelectorAll('#post-grid .post-card');
  var ad = document.getElementById('mid-list-ad');
  if (!ad || cards.length < 5) return;
  if (!ad.querySelector('ins, iframe, script')) return;
  cards[3].insertAdjacentElement('afterend', ad);
  ad.style.display = 'block';
});
//]]>
</script>

</body>
</html>
