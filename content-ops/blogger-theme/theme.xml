<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateVersion='2.0.0' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>

  <b:skin><![CDATA[
/* ===== RESET & BASE ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Noto Sans KR','Apple SD Gothic Neo',sans-serif;font-size:17px;line-height:1.85;color:#222;background:#f5f5f5}
a{color:#1a73e8;text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%;height:auto}

/* ===== LAYOUT ===== */
.outer-wrapper{max-width:1160px;margin:0 auto;padding:0 16px}
.content-wrapper-outer{max-width:1360px}
.content-wrapper{display:grid;grid-template-columns:140px 1fr 140px;gap:20px;align-items:flex-start;margin-top:24px}
.main-content{min-width:0}
/* ===== 서랍(검색·카테고리·최근 글): 버튼을 누르면 오른쪽에서 열림 ===== */
.sidebar-wrapper{position:fixed;top:0;right:0;bottom:0;z-index:1000;width:min(340px,88vw);overflow-y:auto;padding:16px;background:#f5f5f5;box-shadow:-8px 0 24px rgba(0,0,0,.15);transform:translateX(100%);visibility:hidden;transition:transform .25s ease,visibility .25s}
body.drawer-open .sidebar-wrapper{transform:none;visibility:visible}
body.drawer-open{overflow:hidden}
.drawer-backdrop{position:fixed;inset:0;z-index:999;background:rgba(0,0,0,.35);opacity:0;pointer-events:none;transition:opacity .2s}
body.drawer-open .drawer-backdrop{opacity:1;pointer-events:auto}
.drawer-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;font-size:16px;font-weight:700;color:#1a1a1a}
.drawer-close{width:36px;height:36px;border:0;border-radius:999px;background:#fff;font-size:20px;line-height:1;cursor:pointer;color:#333}
.drawer-close:hover{background:#e9ecf2}
nav.blog-nav li.nav-drawer{margin-left:auto}
.drawer-open-btn{display:block;padding:10px 14px;border:0;background:none;color:#fff;font-size:14px;font-weight:700;font-family:inherit;cursor:pointer}
.drawer-open-btn:hover{background:rgba(255,255,255,.15)}

/* ===== 좌우 세로 광고 (쿠팡 140x600) — 박스 없이 배너만 ===== */
.ad-rail{width:140px}
.ad-rail-sticky{position:sticky;top:24px;text-align:center}
.ad-rail-sticky iframe{display:block;margin:0 auto;border:0}
.ad-rail-note{font-size:10.5px;line-height:1.4;color:#999;margin-top:6px;word-break:keep-all}

/* 광고 코드가 비어 있는 자리는 숨김 ('광고' 글자만 있는 빈 상자 방지) */
.ad-header:not(:has(ins,iframe,script)),
.ad-sidebar:not(:has(ins,iframe,script)),
.ad-post-footer:not(:has(ins,iframe,script)){display:none}

/* ===== 글 목록 중간 광고 ===== */
.ad-mid-list{background:#fff;border-radius:8px;text-align:center;padding:14px;margin-bottom:20px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.post-grid .ad-mid-list{grid-column:1/-1;margin:0}

/* ===== HEADER ===== */
#header{background:#1a73e8;color:#fff;padding:0}
#header h1{font-size:22px;font-weight:700;padding:16px 0}
#header h1 a{color:#fff}
#header p.description{font-size:13px;opacity:.85;padding-bottom:14px}

/* ===== 헤더 광고 ===== */
.ad-header{background:#fff;text-align:center;padding:10px 0;border-bottom:1px solid #e0e0e0}

/* ===== NAV ===== */
nav.blog-nav{background:#155db2;padding:0 16px}
nav.blog-nav ul{display:flex;list-style:none;gap:0;max-width:1100px;margin:0 auto}
nav.blog-nav li a{display:block;padding:10px 14px;color:#fff;font-size:14px;font-weight:500}
nav.blog-nav li a:hover{background:rgba(255,255,255,.15);text-decoration:none}

/* ===== 글 목록: 카드 그리드 (bradstudio.xyz 스타일) ===== */
.post-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.post-card{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid #e3e6ea;border-radius:12px;overflow:hidden;transition:box-shadow .2s ease,transform .2s ease}
.post-card:hover{box-shadow:0 4px 14px rgba(15,18,25,.1)}
.card-thumb{display:block;aspect-ratio:2/1;background:#e9ecf2;overflow:hidden}
.card-thumb img{display:block;width:100%;height:100%;object-fit:cover}
.card-thumb-empty{display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:0 10px;background:linear-gradient(135deg,#1a73e8,#155db2);color:#fff;font-size:12px;font-weight:700;text-align:center}
.card-body{display:flex;flex-direction:column;gap:5px;padding:9px 10px 11px}
.card-top{display:flex;flex-wrap:wrap;align-items:center;gap:3px 6px;font-size:11px;color:#5d6c7b;line-height:1.4}
.card-cat{padding:1px 6px;border-radius:999px;background:rgba(26,115,232,.1);color:#1a73e8;font-weight:700;white-space:nowrap}
.card-date{white-space:nowrap}
.card-title{font-size:14px;font-weight:700;line-height:1.4;word-break:keep-all;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card-title a{color:#0a1317}
.card-title a:hover{text-decoration:none;color:#0a1317}
/* 카드 전체를 클릭 영역으로 */
.card-title a::after{content:'';position:absolute;inset:0}
/* 촘촘한 목록: 요약은 숨김 */
.card-snippet{display:none}

/* ===== POST (글 상세) ===== */
.post-outer{background:#fff;border-radius:8px;margin-bottom:20px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.post-title{font-size:20px;font-weight:700;padding:20px 20px 6px;line-height:1.4}
.post-title a{color:#1a1a1a}
.post-title a:hover{color:#1a73e8;text-decoration:none}
.post-meta{font-size:13px;color:#888;padding:0 20px 10px}
.post-body{padding:0 20px 20px;color:#333;line-height:1.9}
.post-body h2{font-size:19px;font-weight:700;margin:28px 0 10px;color:#1a1a1a;border-left:4px solid #1a73e8;padding-left:10px}
.post-body h3{font-size:16px;font-weight:700;margin:20px 0 8px;color:#333}
.post-body p{margin-bottom:14px}
.post-body ul,.post-body ol{margin:10px 0 16px 22px}
.post-body li{margin-bottom:6px}
.post-body table{width:100%;border-collapse:collapse;margin:16px 0;font-size:15px}
.post-body table th{background:#1a73e8;color:#fff;padding:10px 12px;text-align:left}
.post-body table td{padding:9px 12px;border-bottom:1px solid #e8e8e8}
.post-body table tr:nth-child(even){background:#f8f9ff}

/* ===== 신청 링크 섹션 ===== */
.post-body .apply-links{background:#e8f0fe;border-radius:8px;padding:18px 20px;margin:24px 0}
.post-body .apply-links h3{color:#1a73e8;margin-bottom:12px;font-size:16px}
.post-body .apply-links ul{margin-left:0;list-style:none}
.post-body .apply-links li{margin-bottom:10px;padding:10px 14px;background:#fff;border-radius:6px;border-left:3px solid #1a73e8}
.post-body .apply-links a{font-weight:700;font-size:15px;color:#1a73e8}
.post-body .apply-links a:hover{text-decoration:underline}

/* ===== 인아티클 광고 ===== */
.ad-in-article{text-align:center;margin:28px 0;padding:10px;background:#fafafa;border-top:1px solid #eee;border-bottom:1px solid #eee}
.ad-label{font-size:11px;color:#aaa;margin-bottom:4px}

/* ===== 포스트 하단 광고 ===== */
.ad-post-footer{text-align:center;margin:28px 0}

/* ===== LABEL (태그) ===== */
.post-labels{padding:8px 20px 16px;font-size:13px}
.post-labels span{margin-right:4px;color:#888}
.post-labels a{display:inline-block;background:#e8f0fe;color:#1a73e8;border-radius:20px;padding:3px 10px;font-size:12px;margin:2px}
.post-labels a:hover{background:#1a73e8;color:#fff;text-decoration:none}

/* ===== SIDEBAR ===== */
.sidebar-wrapper .widget{background:#fff;border-radius:8px;padding:18px;margin-bottom:18px;box-shadow:0 1px 4px rgba(0,0,0,.07)}
.sidebar-wrapper h2.title{font-size:15px;font-weight:700;color:#1a1a1a;border-bottom:2px solid #1a73e8;padding-bottom:8px;margin-bottom:12px}
.sidebar-wrapper .widget ul{list-style:none}
.sidebar-wrapper .widget li{padding:7px 0;border-bottom:1px solid #f0f0f0;font-size:14px}
.sidebar-wrapper .widget li:last-child{border:none}
.ad-sidebar{text-align:center}

/* ===== PAGINATION ===== */
.blog-pager{text-align:center;padding:24px 0}
.blog-pager a{display:inline-block;padding:9px 22px;background:#fff;color:#0a1317;border:1px solid #e3e6ea;border-radius:999px;font-size:14px;margin:4px}
.blog-pager a:hover{background:#0a1317;color:#fff;border-color:transparent;text-decoration:none}

/* ===== 더 보기 ===== */
.more-wrap{text-align:center;padding:24px 0}
.more-btn{padding:11px 36px;background:#fff;color:#0a1317;border:1px solid #e3e6ea;border-radius:999px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit}
.more-btn:hover{background:#0a1317;color:#fff;border-color:transparent}
.more-btn:disabled{opacity:.6;cursor:wait}

/* ===== FOOTER ===== */
#footer{background:#222;color:#aaa;text-align:center;padding:24px 16px;margin-top:40px;font-size:13px}
#footer a{color:#888}

/* ===== RESPONSIVE ===== */
@media(max-width:1279px){
  .content-wrapper{grid-template-columns:140px 1fr}
  .ad-rail-right{display:none}
}
@media(max-width:900px){
  .content-wrapper{grid-template-columns:1fr}
  .ad-rail-left{display:none}
}
@media(max-width:640px){
  .post-title{font-size:18px}
  .post-body h2{font-size:17px}
  nav.blog-nav ul{flex-wrap:wrap}
  .post-grid{grid-template-columns:repeat(2,1fr);gap:8px}
}
  ]]></b:skin>
</head>

<body>

<!-- 헤더 광고 (애드센스 승인 후 코드 삽입) -->
<div class='ad-header'>
  <div class='outer-wrapper'>
    <div class='ad-label'>광고</div>
    <!-- ADSENSE-HEADER-START -->
    <!-- 여기에 애드센스 헤더 광고 코드 붙여넣기 (728x90 또는 반응형) -->
    <!-- ADSENSE-HEADER-END -->
  </div>
</div>

<!-- 헤더 -->
<div id='header'>
  <div class='outer-wrapper'>
    <b:section class='header' id='header' maxwidgets='1' showaddelement='no'>
      <b:widget id='Header1' locked='true' title='함께 살아갑니다 (Header)' type='Header' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='displayUrl'/>
          <b:widget-setting name='displayHeight'>0</b:widget-setting>
          <b:widget-setting name='sectionWidth'>-1</b:widget-setting>
          <b:widget-setting name='useImage'>false</b:widget-setting>
          <b:widget-setting name='shrinkToFit'>false</b:widget-setting>
          <b:widget-setting name='imagePlacement'>BEHIND</b:widget-setting>
          <b:widget-setting name='displayWidth'>0</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:if cond='data:title != &quot;&quot;'>
            <h1><a expr:href='data:blog.homepageUrl'><data:title/></a></h1>
          </b:if>
          <b:if cond='data:description != &quot;&quot;'>
            <p class='description'><data:description/></p>
          </b:if>
        </b:includable>
        <b:includable id='behindImageStyle'>
    <b:if cond='data:sourceUrl'>
      <b:include cond='data:this.image' data='{                    image: data:this.image,                    selector: &quot;.header-widget&quot;                  }' name='responsiveImageStyle'/>
      <style type='text/css'>
        .header-widget {
          background-position: <data:blog.locale.languageAlignment/>;
          background-repeat: no-repeat;
          background-size: cover;
        }
      </style>
    </b:if>
  </b:includable>
        <b:includable id='description'>
    <p>
      <data:this.description/>
    </p>
  </b:includable>
        <b:includable id='image'>
    <a class='header-image-wrapper' expr:href='data:blog.homepageUrl'>
      <b:include data='{                                                 image: data:image,                                                 altText: data:blog.title.escaped,                                                 originalWidth: data:width,                                                 originalHeight: data:height                                               }' name='responsiveImage'/>
    </a>
  </b:includable>
        <b:includable id='title'>
    <h1>
      <b:tag cond='data:view.url != data:blog.homepageUrl' expr:href='data:blog.homepageUrl' name='a'>
        <data:title/>
      </b:tag>
    </h1>
  </b:includable>
      </b:widget>
    </b:section>
  </div>
</div>

<!-- 네비게이션 -->
<nav class='blog-nav'>
  <ul>
    <li><a expr:href='data:blog.homepageUrl'>홈</a></li>
    <li><a href='/search/label/지원금·복지?max-results=50'>지원금&#183;복지</a></li>
    <li><a href='/search/label/생활·재테크?max-results=50'>생활&#183;재테크</a></li>
    <li><a href='/search/label/IT·신제품?max-results=50'>IT&#183;신제품</a></li>
    <li><a href='/search/label/해외 이슈?max-results=50'>해외 이슈</a></li>
    <li class='nav-drawer'><button aria-controls='side-drawer' aria-expanded='false' class='drawer-open-btn' id='drawer-open' type='button'>&#9776; 검색&#183;카테고리</button></li>
  </ul>
</nav>

<!-- 본문 -->
<div class='outer-wrapper content-wrapper-outer'>
  <div class='content-wrapper'>

    <!-- 왼쪽 세로 광고 (쿠팡 140&#215;600) -->
    <aside class='ad-rail ad-rail-left' aria-label='광고'>
      <div class='ad-rail-sticky'>
        <script src='https://ads-partners.coupang.com/g.js'></script>
        <script>
        //<![CDATA[
        new PartnersCoupang.G({"id":1042784,"template":"carousel","trackingCode":"AF1584187","width":"140","height":"600","tsource":""});
        //]]>
        </script>
        <p class='ad-rail-note'>이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
      </div>
    </aside>

    <!-- 메인 콘텐츠 -->
    <div class='main-content'>
      <b:section class='main' id='main' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='showDateHeader'>false</b:widget-setting>
            <b:widget-setting name='showShareButtons'>true</b:widget-setting>
            <b:widget-setting name='showCommentLink'>true</b:widget-setting>
            <b:widget-setting name='showAuthor'>false</b:widget-setting>
            <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
            <b:widget-setting name='timestampLabel'/>
            <b:widget-setting name='reactionsLabel'/>
            <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
            <b:widget-setting name='style.layout'>1x1</b:widget-setting>
            <b:widget-setting name='showLabels'>true</b:widget-setting>
            <b:widget-setting name='showLocation'>true</b:widget-setting>
            <b:widget-setting name='postLabelsLabel'/>
            <b:widget-setting name='showTimestamp'>true</b:widget-setting>
            <b:widget-setting name='postsPerAd'>1</b:widget-setting>
            <b:widget-setting name='showBacklinks'>false</b:widget-setting>
            <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            <b:widget-setting name='showReactions'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:if cond='data:view.isSingleItem'>
              <!-- ===== 글 상세 / 정적 페이지: 전체 본문 ===== -->
              <b:loop values='data:posts' var='post'>
                <div class='post-outer' itemscope='' itemtype='http://schema.org/BlogPosting'>

                  <h2 class='post-title' itemprop='name headline'>
                    <a expr:href='data:post.url' itemprop='url'><data:post.title/></a>
                  </h2>

                  <div class='post-meta'>
                    <span itemprop='datePublished'><data:post.date/></span>
                  </div>

                  <div class='post-body' itemprop='articleBody'>
                    <data:post.body/>

                    <!-- 인아티클 광고 (포스트 하단) -->
                    <div class='ad-post-footer'>
                      <div class='ad-label'>광고</div>
                      <!-- ADSENSE-POST-FOOTER-START -->
                      <!-- 여기에 애드센스 인아티클 또는 반응형 광고 코드 -->
                      <!-- ADSENSE-POST-FOOTER-END -->
                    </div>
                  </div>

                  <b:if cond='data:post.labels'>
                    <div class='post-labels'>
                      <span>태그:</span>
                      <b:loop values='data:post.labels' var='label'>
                        <a expr:href='data:label.url'>#<data:label.name/></a>
                      </b:loop>
                    </div>
                  </b:if>

                </div>
              </b:loop>
            <b:else/>
              <!-- ===== 홈·라벨·검색·보관함: 카드 그리드 ===== -->
              <div class='post-grid' id='post-grid'>
                <b:loop values='data:posts' var='post'>
                  <article class='post-card' itemscope='' itemtype='http://schema.org/BlogPosting'>
                    <a aria-hidden='true' class='card-thumb' expr:href='data:post.url' tabindex='-1'>
                      <b:if cond='data:post.featuredImage'>
                        <img alt='' expr:src='data:post.featuredImage' loading='lazy'/>
                      <b:else/>
                        <span class='card-thumb-empty'><data:blog.title/></span>
                      </b:if>
                    </a>
                    <div class='card-body'>
                      <div class='card-top'>
                        <b:loop index='i' values='data:post.labels' var='label'>
                          <b:if cond='data:i == 0'>
                            <span class='card-cat'><data:label.name/></span>
                          </b:if>
                        </b:loop>
                        <span class='card-date' itemprop='datePublished'><data:post.date/></span>
                      </div>
                      <h2 class='card-title' itemprop='name headline'>
                        <a expr:href='data:post.url' itemprop='url'><data:post.title/></a>
                      </h2>
                      <p class='card-snippet'><data:post.snippet/></p>
                    </div>
                  </article>
                </b:loop>
              </div>

              <!-- 글 목록 중간 광고 (JS로 4번째 카드 뒤에 삽입, 광고 코드가 있을 때만 표시) -->
              <div class='ad-mid-list' id='mid-list-ad' style='display:none'>
                <div class='ad-label'>광고</div>
                <!-- ADSENSE-MID-LIST-START -->
                <!-- 반응형 광고 코드 붙여넣기 -->
                <!-- ADSENSE-MID-LIST-END -->
              </div>

              <!-- 페이지네이션 -->
              <div class='blog-pager'>
                <b:if cond='data:newerPageUrl'>
                  <a expr:href='data:newerPageUrl'>&#8592; 최신 글</a>
                </b:if>
                <b:if cond='data:olderPageUrl'>
                  <a expr:href='data:olderPageUrl' id='older-link'>이전 글 &#8594;</a>
                </b:if>
              </div>
              <div class='more-wrap' id='more-wrap' style='display:none'>
                <button class='more-btn' id='load-more' type='button'>더 보기</button>
              </div>
            </b:if>
          </b:includable>
          <b:includable id='aboutPostAuthor'>
  <div class='author-name'>
    <a class='g-profile' expr:href='data:post.author.profileUrl' rel='author' title='author profile'>
      <span>
        <data:post.author.name/>
      </span>
    </a>
  </div>
  <div>
    <span class='author-desc'>
      <data:post.author.aboutMe/>
    </span>
  </div>
</b:includable>
          <b:includable id='addComments'>
  <a expr:href='data:post.commentsUrl' expr:onclick='data:post.commentsUrlOnclick'>
    <b:message name='messages.postAComment'/>
  </a>
</b:includable>
          <b:includable id='commentAuthorAvatar'>
  <div class='avatar-image-container'>
    <img class='author-avatar' expr:src='data:comment.authorAvatarSrc' height='35' width='35'/>
  </div>
</b:includable>
          <b:includable id='commentDeleteIcon' var='comment'>
  <span expr:class='&quot;item-control &quot; + data:comment.adminClass'>
    <b:if cond='data:showCmtPopup'>
      <div class='goog-toggle-button'>
        <div class='goog-inline-block comment-action-icon'/>
      </div>
    <b:else/>
      <a class='comment-delete' expr:href='data:comment.deleteUrl' expr:title='data:messages.deleteComment'>
        <img src='https://resources.blogblog.com/img/icon_delete13.gif'/>
      </a>
    </b:if>
  </span>
</b:includable>
          <b:includable id='commentForm' var='post'>
  <div class='comment-form'>
    <a name='comment-form'/>
    <h4 id='comment-post-message'><data:messages.postAComment/></h4>
