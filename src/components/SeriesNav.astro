---
import { getVisiblePosts } from '../lib/content';
import { SERIES } from '../lib/series';

interface Props {
	series: { id: string; order: number };
}

const { series } = Astro.props;
const def = SERIES[series.id];
const posts = def
	? (await getVisiblePosts())
			.filter((p) => p.data.series?.id === series.id)
			.sort((a, b) => a.data.series!.order - b.data.series!.order)
	: [];
const prev = posts.filter((p) => p.data.series!.order < series.order).at(-1);
const next = posts.find((p) => p.data.series!.order > series.order);
---

{
	def && (
		<nav class="series-nav" aria-label={`${def.title} 시리즈`}>
			<p class="label">
				<a href={`/series/${def.id}/`}>연재 · {def.title}</a>
				<span>
					{series.order} / {def.plan.length}편
				</span>
			</p>
			<div class="links">
				{prev ? (
					<a class="prev" href={`/blog/${prev.id}/`}>
						<small>이전 편</small>
						{prev.data.title}
					</a>
				) : (
					<span />
				)}
				{next ? (
					<a class="next" href={`/blog/${next.id}/`}>
						<small>다음 편</small>
						{next.data.title}
					</a>
				) : (
					series.order < def.plan.length && (
						<span class="next upcoming">
							<small>다음 편 (준비 중)</small>
							{def.plan[series.order]}
						</span>
					)
				)}
			</div>
		</nav>
	)
}

<style>
	.series-nav {
		margin: 2.5rem 0 1rem;
		padding: 1rem 1.1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--rounded-xl);
		background: #f8f6f2;
	}
	.label {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		font-weight: 700;
	}
	.label a {
		color: rgb(var(--black));
	}
	.label span {
		color: rgb(var(--gray));
		font-weight: 400;
		white-space: nowrap;
	}
	.links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	.links a,
	.links .upcoming {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 0.92rem;
		line-height: 1.45;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.links a:hover {
		color: var(--accent);
	}
	.links .next {
		text-align: right;
	}
	.links .upcoming {
		color: rgb(var(--gray));
	}
	small {
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}
	@media (max-width: 600px) {
		.links {
			grid-template-columns: 1fr;
		}
		.links .next {
			text-align: left;
		}
	}
</style>
