---
// 인스타 캐러셀 공식 임베드 — blockquote + embed.js (토큰 불필요).
// 스크립트가 막혀도 링크는 남는다. 같은 주제 카드뉴스로 체류·재방문 유도.
interface Props {
	permalink: string;
}

const { permalink } = Astro.props;
---

<section class="instagram-embed">
	<h2>인스타그램 카드뉴스로 보기</h2>
	<blockquote class="instagram-media" data-instgrm-permalink={permalink} data-instgrm-version="14">
		<a href={permalink} rel="noopener">인스타그램에서 카드뉴스 보기</a>
	</blockquote>
	<script is:inline async src="https://www.instagram.com/embed.js"></script>
</section>

<style>
	.instagram-embed {
		margin: 2.5rem 0;
	}
	.instagram-embed blockquote {
		max-width: 540px;
		width: 100%;
		margin: 1rem auto;
	}
</style>
