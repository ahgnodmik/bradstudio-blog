---
// 글 목록 카드와 같은 모양으로 섞여 들어가는 In-feed 네이티브 광고.
// 목록의 <li> 자리에 그대로 넣어 사용.
import { AD_INFEED_LAYOUT_KEY, AD_SLOTS, ADSENSE_CLIENT } from '../consts';

const slotId = AD_SLOTS.listMid;
const enabled = ADSENSE_CLIENT !== '' && slotId !== '' && AD_INFEED_LAYOUT_KEY !== '';
const showPlaceholder = !enabled && import.meta.env.DEV;
---

{
	enabled ? (
		<li class="ad-card">
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={slotId}
				data-ad-format="fluid"
				data-ad-layout-key={AD_INFEED_LAYOUT_KEY}
			/>
			<script is:inline>
				(window.adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		</li>
	) : showPlaceholder ? (
		<li class="ad-card ad-card-placeholder">
			<div class="fake-image">In-feed AD</div>
			<h4 class="fake-title">광고 카드 자리 (실제로는 글 카드와 동일한 형태)</h4>
			<p class="fake-date">Sponsored</p>
		</li>
	) : null
}

<style>
	.ad-card {
		width: calc(50% - 1rem);
	}
	.fake-image {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1200 / 630;
		margin-bottom: 0.5rem;
		border: 2px dashed rgb(var(--gray-light));
		border-radius: 12px;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		letter-spacing: 0.05em;
	}
	.fake-title {
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1.3;
	}
	.fake-date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		.ad-card {
			width: 100%;
		}
	}
</style>
