---
// 글 목록 카드와 같은 모양으로 섞여 들어가는 In-feed 네이티브 광고.
// 목록의 <li> 자리에 그대로 넣어 사용.
// deferred: '더 보기' 전까지 숨겨진 자리. 숨긴 상태로 push하면 AdSense가 폭 0 오류를 내므로
// 목록 페이지 스크립트가 보이게 만든 뒤 push한다.
import { AD_INFEED_LAYOUT_KEY, AD_SLOTS, ADSENSE_CLIENT } from '../consts';

interface Props {
	deferred?: boolean;
	// 목록이 <ul>이면 li, <div class="post-grid">면 div
	as?: 'li' | 'div';
	// 4열 그리드용: 카드 2칸 폭. fluid 광고는 최소 250px 폭이 필요한데 4열 카드 한 칸은 약 244px
	wide?: boolean;
}

const { deferred = false, as: Tag = 'li', wide = false } = Astro.props;

const slotId = AD_SLOTS.listMid;
const enabled = ADSENSE_CLIENT !== '' && slotId !== '' && AD_INFEED_LAYOUT_KEY !== '';
---

{
	enabled ? (
		<Tag class:list={['ad-card', { 'ad-deferred': deferred, 'ad-wide': wide }]} data-ad-label="인피드 네이티브 광고 · 글 카드형">
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={slotId}
				data-ad-format="fluid"
				data-ad-layout-key={AD_INFEED_LAYOUT_KEY}
			/>
			{!deferred && (
				<script is:inline>
					// 광고가 채워질 때만 칸을 남긴다. 3초 안에 filled가 아니면(미승인·재고 없음·차단) 칸을 접어
					// 그리드 빈칸을 없애고, 늦게 채워지면 다시 펼친다.
					window.bsAdWatch =
						window.bsAdWatch ||
						function (box) {
							var ins = box.querySelector('ins.adsbygoogle');
							if (!ins) return;
							var sync = function () {
								box.classList.toggle('ad-empty', ins.getAttribute('data-ad-status') !== 'filled');
							};
							new MutationObserver(sync).observe(ins, { attributes: true, attributeFilter: ['data-ad-status'] });
							setTimeout(sync, 3000);
						};
					// fluid 광고는 폭 250px 미만이면 요청 거부(TagError) → 미만이면 요청하지 않음
					(function (box) {
						if (!box) return;
						if (box.offsetWidth >= 250) (window.adsbygoogle = window.adsbygoogle || []).push({});
						window.bsAdWatch(box);
					})(document.currentScript && document.currentScript.parentElement);
				</script>
			)}
		</Tag>
	) : import.meta.env.DEV ? (
		<Tag class:list={['ad-card', 'ad-card-placeholder', 'ad-placeholder', { 'ad-deferred': deferred, 'ad-wide': wide }]}>
			<div class="fake-image">인피드 네이티브 광고 · listMid</div>
			<h4 class="fake-title">광고 카드 자리 (실제로는 글 카드와 동일한 형태)</h4>
			<p class="fake-date">Sponsored</p>
		</Tag>
	) : null
}

<style>
	/* 글 카드 한 칸 크기로 섞여 들어감(한 줄 전체를 차지하지 않음) */
	.ad-card {
		width: 100%;
		/* AdSense fluid 최소 폭 */
		min-width: 250px;
		border-radius: 14px;
		overflow: hidden;
	}
	/* 4열 구간(769px 이상)에서만 2칸. 2열·1열에선 한 칸이 이미 250px 이상 */
	@media (min-width: 769px) {
		.ad-wide {
			grid-column: span 2;
		}
	}
	/* 광고가 안 채워지면(unfilled) 빈 줄이 그리드 간격만 차지하므로 숨긴다 */
	.ad-deferred,
	.ad-card:has(ins[data-ad-status='unfilled']) {
		display: none;
	}
	.fake-image {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1200 / 630;
		margin-bottom: 0.5rem;
		border: 2px dashed rgb(var(--gray-light));
		border-radius: 12px;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		letter-spacing: 0.05em;
	}
	.fake-title {
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1.3;
	}
	.fake-date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		.ad-card {
			width: 100%;
		}
	}
</style>
