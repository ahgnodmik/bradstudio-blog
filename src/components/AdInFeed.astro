---
// 글 목록 카드와 같은 모양으로 섞여 들어가는 In-feed 네이티브 광고.
// 목록의 <li> 자리에 그대로 넣어 사용.
// deferred: '더 보기' 전까지 숨겨진 자리. 숨긴 상태로 push하면 AdSense가 폭 0 오류를 내므로
// 목록 페이지 스크립트가 보이게 만든 뒤 push한다.
import { AD_INFEED_LAYOUT_KEY, AD_SLOTS, ADSENSE_CLIENT } from '../consts';

interface Props {
	deferred?: boolean;
}

const { deferred = false } = Astro.props;

const slotId = AD_SLOTS.listMid;
const enabled = ADSENSE_CLIENT !== '' && slotId !== '' && AD_INFEED_LAYOUT_KEY !== '';
---

{
	enabled ? (
		<li class:list={['ad-card', { 'ad-deferred': deferred }]} data-ad-label="인피드 네이티브 광고 · 글 카드형">
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={slotId}
				data-ad-format="fluid"
				data-ad-layout-key={AD_INFEED_LAYOUT_KEY}
			/>
			{!deferred && (
				<script is:inline>
					(window.adsbygoogle = window.adsbygoogle || []).push({});
				</script>
			)}
		</li>
	) : (
		<li class:list={['ad-card', 'ad-card-placeholder', 'ad-placeholder', { 'ad-deferred': deferred }]}>
			<div class="fake-image">인피드 네이티브 광고 · listMid</div>
			<h4 class="fake-title">광고 카드 자리 (실제로는 글 카드와 동일한 형태)</h4>
			<p class="fake-date">Sponsored</p>
		</li>
	)
}

<style>
	.ad-card {
		width: 100%;
	}
	/* 광고가 안 채워지면(unfilled) 빈 줄이 그리드 간격만 차지하므로 숨긴다 */
	.ad-deferred,
	.ad-card:has(ins[data-ad-status='unfilled']) {
		display: none;
	}
	.fake-image {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1200 / 630;
		margin-bottom: 0.5rem;
		border: 2px dashed rgb(var(--gray-light));
		border-radius: 12px;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		letter-spacing: 0.05em;
	}
	.fake-title {
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1.3;
	}
	.fake-date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		.ad-card {
			width: 100%;
		}
	}
</style>
