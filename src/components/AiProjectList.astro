---
// Neubrutalist bento grid (Gumroad-style): thick ink borders, hard offset
// shadows, flat saturated fills. Card size/color are set per project.
type ProjectStatus = '운영 중' | '개발 중' | '케이스 스터디';
type TileSize = 'lg' | 'wide' | 'md' | 'sm';
type TileColor = 'pink' | 'yellow' | 'mint' | 'orange' | 'blue' | 'paper';

interface Project {
	title: string;
	description: string;
	status: ProjectStatus;
	tags: string[];
	size: TileSize;
	color: TileColor;
}

interface ProjectGroup {
	title: string;
	description: string;
	projects: Project[];
}

const groups: ProjectGroup[] = [
	{
		title: '앱',
		description: '아이디어를 실제 사용 가능한 모바일·웹 제품으로 구현한 작업입니다.',
		projects: [
			{
				title: 'OCR 기반 노트 생성 앱',
				description: '촬영·스캔 문서를 구조화된 노트로 변환하는 모바일 앱. 스토어 출시 및 운영 중입니다.',
				status: '운영 중',
				tags: ['Flutter', 'OCR', 'AdMob'],
				size: 'lg',
				color: 'pink',
			},
			{
				title: '실시간 환율 변환 앱',
				description: '20개 통화의 실시간 환율을 조회하고 바로 변환할 수 있는 앱. 스토어 출시 및 운영 중입니다.',
				status: '운영 중',
				tags: ['Flutter', 'REST API', 'AdMob'],
				size: 'sm',
				color: 'yellow',
			},
			{
				title: '장소 기록 모바일 앱',
				description: '장소를 카드로 기록하고 탐색하는 앱. 필드 암호화, 다국어, 지도 연동을 포함해 운영 중입니다.',
				status: '운영 중',
				tags: ['Flutter', 'Firebase', 'Google Maps'],
				size: 'sm',
				color: 'mint',
			},
			{
				title: '단체 주문 자동화 앱',
				description: '공유 링크로 참여자의 주문을 자동 집계하는 앱. 비회원 참여와 실시간 동기화를 설계했습니다.',
				status: '케이스 스터디',
				tags: ['Flutter', 'Firestore', 'Riverpod'],
				size: 'md',
				color: 'paper',
			},
			{
				title: '주간 식단·장보기 리스트 생성기',
				description: '알레르기, 예산, 조리 실력을 반영해 7일 식단과 합산 장보기 리스트를 만드는 MVP입니다.',
				status: '케이스 스터디',
				tags: ['Next.js', 'Supabase', 'LLM'],
				size: 'md',
				color: 'orange',
			},
		],
	},
	{
		title: 'AI 자동화',
		description: '반복 업무를 수집·생성·검수·발행 흐름으로 연결한 AI 기반 작업입니다.',
		projects: [
			{
				title: '블로그 콘텐츠 자동 발행 파이프라인',
				description: '키워드 수집부터 원고 생성과 발행까지 무인 운영한 일일 자동 발행 시스템입니다.',
				status: '케이스 스터디',
				tags: ['Python', 'LLM', 'Automation'],
				size: 'wide',
				color: 'yellow',
			},
			{
				title: 'SNS 카드뉴스 자동화 파이프라인',
				description: '소재 수집, 카드 렌더링, 게시까지 이어지는 멀티 계정 콘텐츠 자동화 시스템입니다.',
				status: '개발 중',
				tags: ['Node.js', 'Supabase', 'Automation'],
				size: 'md',
				color: 'blue',
			},
			{
				title: '해외 신상품 모니터링 시스템',
				description: '해외 커머스 신상품을 수집·필터링해 메신저로 전달하는 소싱 레이더입니다.',
				status: '개발 중',
				tags: ['Node.js', 'Apify', 'Telegram Bot'],
				size: 'md',
				color: 'paper',
			},
		],
	},
];
---

<div class="project-groups">
	{
		groups.map((group) => (
			<section class="project-group" aria-labelledby={`ai-project-${group.title}`}>
				<div class="group-heading">
					<h2 id={`ai-project-${group.title}`}>
						{group.title}
						<span class="count" aria-label={`${group.projects.length}개 작업`}>
							{group.projects.length}
						</span>
					</h2>
					<p>{group.description}</p>
				</div>
				<ul class="bento">
					{group.projects.map((project, index) => (
						<li class:list={['tile', `tile-${project.size}`, `tile-${project.color}`]}>
							<div class="tile-top">
								<span class="tile-number" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class:list={['status', { live: project.status === '운영 중' }]}>
									{project.status}
								</span>
							</div>
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<ul class="tag-list" aria-label="사용 기술">
								{project.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.project-groups {
		--ink: #000;
		--nb-border: 2px solid var(--ink);
		--nb-shadow: 4px 4px 0 var(--ink);
		display: grid;
		gap: 3.5rem;
		margin-top: 2.5rem;
	}
	.project-group {
		min-width: 0;
	}
	.group-heading {
		margin-bottom: 1.25rem;
	}
	.group-heading h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.25rem;
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.count {
		display: inline-grid;
		place-items: center;
		min-width: 1.75rem;
		height: 1.75rem;
		padding: 0 0.4rem;
		border: var(--nb-border);
		border-radius: var(--rounded-full);
		background: #ffc900;
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
	}
	.group-heading p {
		max-width: 42rem;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.bento,
	.tag-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-flow: row dense;
		gap: 1rem;
	}
	.tile {
		display: flex;
		flex-direction: column;
		min-width: 0;
		margin: 0;
		padding: 1.25rem;
		border: var(--nb-border);
		border-radius: 6px;
		box-shadow: var(--nb-shadow);
		color: var(--ink);
		word-break: keep-all;
	}
	.tile-lg {
		grid-column: span 4;
		grid-row: span 2;
		padding: 1.75rem;
	}
	.tile-wide {
		grid-column: span 6;
		padding: 1.75rem;
	}
	.tile-md {
		grid-column: span 3;
	}
	.tile-sm {
		grid-column: span 2;
	}
	.tile-pink {
		background: #ff90e8;
	}
	.tile-yellow {
		background: #ffc900;
	}
	.tile-mint {
		background: #23a094;
	}
	.tile-orange {
		background: #ff7051;
	}
	.tile-blue {
		background: #90a8ed;
	}
	.tile-paper {
		background: #f4f4f0;
	}
	.tile-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	.tile-number {
		font-size: 0.875rem;
		font-weight: 800;
		font-variant-numeric: tabular-nums;
	}
	.tile-lg .tile-number {
		font-size: 3.5rem;
		line-height: 1;
		letter-spacing: -0.05em;
	}
	.status {
		flex: 0 0 auto;
		padding: 0.15rem 0.6rem;
		border: var(--nb-border);
		border-radius: var(--rounded-full);
		background: #fff;
		font-size: 0.7rem;
		font-weight: 800;
		line-height: 1.4;
		white-space: nowrap;
	}
	.status.live::before {
		content: '';
		display: inline-block;
		width: 0.45rem;
		height: 0.45rem;
		margin-right: 0.35rem;
		border-radius: 50%;
		background: #13a35a;
		vertical-align: 0.05rem;
	}
	.tile h3 {
		margin: 0;
		color: var(--ink);
		font-size: 1.125rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.tile-wide h3 {
		font-size: 1.5rem;
	}
	.tile-lg h3 {
		margin-top: auto;
		font-size: 1.75rem;
		line-height: 1.2;
	}
	.tile > p {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.tile-lg > p,
	.tile-wide > p {
		font-size: 1rem;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 1rem;
	}
	.tile-sm .tag-list,
	.tile-md .tag-list {
		margin-top: auto;
		padding-top: 1rem;
	}
	.tag-list li {
		margin: 0;
		padding: 0.15rem 0.5rem;
		border: 1.5px solid var(--ink);
		border-radius: 4px;
		background: #fff;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.4;
	}
	@media (max-width: 600px) {
		.project-groups {
			gap: 2.75rem;
			margin-top: 2rem;
		}
		.bento {
			grid-template-columns: minmax(0, 1fr);
		}
		.tile-lg,
		.tile-wide,
		.tile-md,
		.tile-sm {
			grid-column: auto;
			grid-row: auto;
		}
		.tile-lg,
		.tile-wide {
			padding: 1.25rem;
		}
		.tile-lg .tile-number {
			font-size: 2.5rem;
		}
		.tile-lg h3 {
			margin-top: 0;
			font-size: 1.375rem;
		}
	}
</style>
