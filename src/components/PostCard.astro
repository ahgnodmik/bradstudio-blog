---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { CATEGORIES } from '../consts';

interface Props {
	post: any;
}

const { post } = Astro.props;
const thumb = post.data.thumbnail;
const category = CATEGORIES[post.data.category as keyof typeof CATEGORIES];
---

<article class="post-card">
	{
		thumb ? (
			<img class="bg" src={thumb.url} width="720" height="900" alt="" loading="lazy" />
		) : post.data.heroImage ? (
			<Image class="bg" width={720} height={900} src={post.data.heroImage} alt="" />
		) : (
			<img class="bg" src={`/og/${post.data.contentId}.png`} width="720" height="378" alt="" loading="lazy" />
		)
	}
	<div class="body">
		{category && <span class="cat">{category}</span>}
		<h4 class="title">
			<a class="card-link" href={`/blog/${post.id}/`}>{post.data.title}</a>
		</h4>
		<p class="meta">
			<FormattedDate date={post.data.pubDate} />
			{
				thumb?.creditName && (
					<span class="credit">
						사진{' '}
						{thumb.creditUrl ? (
							<a href={thumb.creditUrl} rel="nofollow noopener">
								{thumb.creditName}
							</a>
						) : (
							thumb.creditName
						)}
						/Unsplash
					</span>
				)
			}
		</p>
	</div>
</article>

<style>
	/* 썸네일을 배경으로 깔고 어둡게 덮은 뒤 텍스트를 올린 타일 카드 */
	.post-card {
		position: relative;
		overflow: hidden;
		aspect-ratio: 1 / 1;
		border-radius: 14px;
		background: #1f2430;
		isolation: isolate;
	}
	.bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.4s ease;
	}
	.post-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgba(10, 12, 18, 0.35) 0%, rgba(10, 12, 18, 0.6) 45%, rgba(10, 12, 18, 0.88) 100%);
		transition: background 0.3s ease;
	}
	.body {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.5rem;
		padding: 1.1rem 1rem 0.9rem;
		color: #fff;
	}
	.cat {
		align-self: flex-start;
		margin-bottom: auto;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(4px);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.post-card .title {
		margin: 0;
		color: #fff;
		font-size: 1.05rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
		word-break: keep-all;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
	}
	.post-card .card-link,
	.post-card .card-link:hover {
		color: #fff;
		text-decoration: none;
	}
	/* 카드 전체를 클릭 영역으로 */
	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.35rem;
		margin: 0;
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.72);
	}
	.meta :global(time) {
		color: inherit;
	}
	.credit {
		opacity: 0.8;
	}
	.credit a {
		position: relative;
		z-index: 1;
		color: inherit;
	}
	.post-card:hover .bg {
		transform: scale(1.05);
	}
	.post-card:hover::before {
		background: linear-gradient(180deg, rgba(10, 12, 18, 0.25) 0%, rgba(10, 12, 18, 0.5) 45%, rgba(10, 12, 18, 0.85) 100%);
	}
	.post-card:focus-within {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	@media (max-width: 600px) {
		.post-card {
			aspect-ratio: 16 / 10;
		}
		.title {
			-webkit-line-clamp: 3;
		}
	}
</style>
