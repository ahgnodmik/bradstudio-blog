---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: any;
}

const { post } = Astro.props;
const thumb = post.data.thumbnail;
---

<div class="post-card">
	<a class="card-link" href={`/blog/${post.id}/`}>
		{
			thumb ? (
				<img src={thumb.url} width="720" height="405" alt={thumb.alt} loading="lazy" />
			) : post.data.heroImage ? (
				<Image width={720} height={405} src={post.data.heroImage} alt="" />
			) : (
				<img src={`/og/${post.data.contentId}.png`} width="720" height="378" alt="" loading="lazy" />
			)
		}
		<h4 class="title">{post.data.title}</h4>
		<p class="date">
			<FormattedDate date={post.data.pubDate} />
		</p>
	</a>
	{
		thumb?.creditName && (
			<p class="credit">
				사진:{' '}
				{thumb.creditUrl ? (
					<a href={thumb.creditUrl} rel="nofollow noopener">
						{thumb.creditName}
					</a>
				) : (
					thumb.creditName
				)}{' '}
				(Unsplash)
			</p>
		)
	}
</div>

<style>
	.card-link {
		display: block;
		text-decoration: none;
	}
	.post-card img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin-bottom: 0.5rem;
		border-radius: 12px;
		transition: 0.2s ease;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1.3;
		transition: 0.2s ease;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		transition: 0.2s ease;
	}
	.credit {
		margin: 0.15rem 0 0;
		font-size: 0.7rem;
		color: rgb(var(--gray));
	}
	.credit a {
		color: inherit;
	}
	.card-link:hover .title,
	.card-link:hover .date {
		color: var(--accent);
	}
	.card-link:hover img {
		box-shadow: var(--box-shadow);
	}
</style>
