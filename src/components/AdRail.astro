---
// 좌우 레일(세로형) 디스플레이 광고. 본문 폭(1080px) 바깥 여백이 충분한 넓은 화면에서만 노출.
// AdSense에서 '디스플레이 광고 — 세로형(160x600 또는 300x600)' 단위를 만들고 AD_SLOTS.railLeft/railRight에 ID 입력.
// AdSense 슬롯이 비어 있으면 쿠팡 파트너스 세로 배너(COUPANG_RAIL)를 고지 문구와 함께 노출.
import { AD_SLOTS, ADSENSE_CLIENT, COUPANG_RAIL } from '../consts';

interface Props {
	side: 'left' | 'right';
}

const { side } = Astro.props;
const slotId = side === 'left' ? AD_SLOTS.railLeft : AD_SLOTS.railRight;
const enabled = ADSENSE_CLIENT !== '' && slotId !== '';
const coupang = !enabled && Boolean(COUPANG_RAIL.id);
const coupangConfig = JSON.stringify({ ...COUPANG_RAIL, tsource: '' });
const showPlaceholder = !enabled && !coupang && import.meta.env.DEV;
---

{
	coupang && (
		<aside class:list={['ad-rail', `ad-rail-${side}`, 'ad-rail-coupang']} aria-label="쿠팡 파트너스 광고">
			<script is:inline src="https://ads-partners.coupang.com/g.js"></script>
			<script is:inline define:vars={{ coupangConfig }}>
				new PartnersCoupang.G(JSON.parse(coupangConfig));
			</script>
			<p class="rail-disclosure">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
		</aside>
	)
}

{
	(enabled || showPlaceholder) && (
		<aside class:list={['ad-rail', `ad-rail-${side}`, { 'ad-rail-placeholder ad-placeholder': showPlaceholder }]} aria-label="광고">
			{enabled ? (
				<>
					<ins
						class="adsbygoogle ad-rail-unit"
						style="display:inline-block;width:160px;height:600px"
						data-ad-client={ADSENSE_CLIENT}
						data-ad-slot={slotId}
					/>
					<script is:inline data-rail={side}>
						// 레일이 숨겨지는 좁은 화면에선 push하지 않는다(폭 0 오류 방지)
						if (window.matchMedia('(min-width: 1480px)').matches) {
							(window.adsbygoogle = window.adsbygoogle || []).push({});
						}
					</script>
				</>
			) : (
				<span>좌우 레일 광고<br />{side === 'left' ? 'railLeft' : 'railRight'} · 160×600</span>
			)}
		</aside>
	)
}

<style>
	.ad-rail {
		display: none;
	}
	@media (min-width: 1480px) {
		.ad-rail {
			display: block;
			position: fixed;
			top: 96px;
			width: 160px;
			height: 600px;
		}
		/* 본문 1080px 가장자리에서 24px 띄움 */
		.ad-rail-left {
			right: calc(50% + 540px + 24px);
		}
		.ad-rail-right {
			left: calc(50% + 540px + 24px);
		}
	}
	.ad-rail-coupang {
		height: auto;
	}
	.rail-disclosure {
		margin: 0.4rem 0 0;
		font-size: 0.68rem;
		line-height: 1.4;
		color: rgb(var(--gray));
		word-break: keep-all;
	}
	.ad-rail-placeholder {
		align-items: center;
		justify-content: center;
		border: 2px dashed #ff7a00;
		border-radius: 12px;
		background: rgba(255, 122, 0, 0.06);
		color: #b35500;
		font-size: 0.8rem;
		text-align: center;
	}
	@media (min-width: 1480px) {
		.ad-rail-coupang {
		height: auto;
	}
	.rail-disclosure {
		margin: 0.4rem 0 0;
		font-size: 0.68rem;
		line-height: 1.4;
		color: rgb(var(--gray));
		word-break: keep-all;
	}
	.ad-rail-placeholder {
			display: flex;
		}
	}
</style>
