---
// 전체 글 목록 한 페이지: 카테고리 탭 + 카드 그리드(페이지당 인피드 광고 1칸) + 번호 페이지 넘김.
// /blog/ (1쪽)와 /blog/page/N/ (2쪽부터)이 같이 쓴다.
import type { Page } from 'astro';
import AdInFeed from './AdInFeed.astro';
import AdRail from './AdRail.astro';
import AdSlot from './AdSlot.astro';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import CategoryTabs from './CategoryTabs.astro';
import Header from './Header.astro';
import PostListCard from './PostListCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	page: Page<any>;
}

const { page } = Astro.props;
// 페이지당 광고 1개: 8번째 카드 뒤 한 줄 전체 (PC 4열 기준 2줄 다음)
const AD_AFTER = 8;
// 기본 보기 단위: PC 4열 × 4줄. '더 보기'는 지금 보기 단위만큼 늘린다.
const STEP = 16;

const pageHref = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`);
// 1 … 4 5 [6] 7 8 … 12 형태
const numbers: (number | '…')[] = [];
for (let n = 1; n <= page.lastPage; n++) {
	if (n === 1 || n === page.lastPage || Math.abs(n - page.currentPage) <= 2) numbers.push(n);
	else if (numbers[numbers.length - 1] !== '…') numbers.push('…');
}
const title = page.currentPage === 1 ? `전체 글 | ${SITE_TITLE}` : `전체 글 ${page.currentPage}쪽 | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				box-sizing: border-box;
				margin: 0 auto;
				padding: 2rem 1em 4rem;
			}
			.list-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.list-head h1 {
				margin: 0;
				font-size: 1.5rem;
			}
			.list-head .total {
				font-size: 0.875rem;
				color: rgb(var(--gray));
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.875rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.list-controls {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
				margin: 2rem 0 0;
			}
			.list-controls[hidden],
			.pager[hidden] {
				display: none;
			}
			.more.size {
				padding: 0.7rem 1.25rem;
				font-weight: 500;
			}
			.more.size[aria-pressed='true'] {
				background: rgb(var(--black));
				border-color: transparent;
				color: #fff;
			}
			.more {
				padding: 0.7rem 2.25rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: #fff;
				font-size: 0.95rem;
				font-weight: 700;
				color: rgb(var(--black));
				cursor: pointer;
			}
			.more:hover {
				background: rgb(var(--black));
				border-color: transparent;
				color: #fff;
			}
			.more:disabled {
				opacity: 0.6;
				cursor: wait;
			}
			.more-left {
				font-weight: 400;
				opacity: 0.7;
			}
			/* 쪽 번호 버튼은 스크립트가 만들므로 :global */
			.pager :global(button) {
				min-width: 2.5rem;
				height: 2.5rem;
				padding: 0 0.75rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: #fff;
				font: inherit;
				font-size: 0.9rem;
				color: rgb(var(--black));
				cursor: pointer;
			}
			.pager :global(button:hover) {
				border-color: var(--accent);
				color: var(--accent);
			}
			.pager :global(button.current) {
				background: rgb(var(--black));
				border-color: transparent;
				color: #fff;
				font-weight: 700;
			}
			.pager {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.35rem;
				margin: 2.5rem 0 0;
			}
			.pager a,
			.pager span {
				min-width: 2.5rem;
				height: 2.5rem;
				box-sizing: border-box;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0 0.75rem;
				border-radius: 999px;
				font-size: 0.9rem;
				text-decoration: none;
				color: rgb(var(--black));
			}
			.pager a {
				border: 1px solid rgb(var(--gray-light));
				background: #fff;
			}
			.pager a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.pager .current {
				background: rgb(var(--black));
				color: #fff;
				font-weight: 700;
			}
			.pager .gap,
			.pager :global(span.gap) {
				min-width: auto;
				display: inline-flex;
				align-items: center;
				padding: 0 0.25rem;
				color: rgb(var(--gray));
			}
			/* 인피드 광고는 한 줄 전체: 카드 4×4 배열을 깨지 않는다 */
			.grid :global(.ad-card) {
				grid-column: 1 / -1;
				min-width: 0;
			}
			.grid > :global(li.is-hidden),
			.grid > :global(.ad-card.is-hidden) {
				display: none;
			}
			@media (max-width: 960px) {
				.grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			@media (max-width: 640px) {
				.grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 0.625rem;
				}
				.pager .step-label {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<AdRail side="left" />
		<AdRail side="right" />
		<main>
			<div class="list-head">
				<h1>전체 글</h1>
				<span class="total">{page.total}편 · {page.currentPage}/{page.lastPage}쪽</span>
			</div>
			<CategoryTabs />
			<ul class="grid" id="post-grid">
				{
					page.data.map((post, index) => (
						<>
							<li class="post-item">
								<PostListCard post={post} compact eager={page.currentPage === 1 && index < 4} />
							</li>
							{index + 1 === AD_AFTER && index < page.data.length - 1 && <AdInFeed />}
						</>
					))
				}
			</ul>
			{
				page.currentPage === 1 && page.total > STEP && (
					<div
						class="list-controls"
						id="list-controls"
						data-next={page.url.next ?? ''}
						data-total={page.total}
						data-step={STEP}
						hidden
					>
						<button class="more" type="button" data-act="more">
							더 보기
						</button>
						<button class="more size" type="button" data-size="50" aria-pressed="false">
							50개 보기
						</button>
						<button class="more size" type="button" data-size="all" aria-pressed="false">
							전체 보기
						</button>
					</div>
					<nav class="pager" id="js-pager" aria-label="페이지" hidden />
				)
			}
			{
				page.lastPage > 1 && (
					<nav class="pager" aria-label="페이지">
						{page.url.prev && (
							<a href={page.url.prev} rel="prev">
								‹ <span class="step-label">이전</span>
							</a>
						)}
						{numbers.map((n) =>
							n === '…' ? (
								<span class="gap">…</span>
							) : n === page.currentPage ? (
								<span class="current" aria-current="page">
									{n}
								</span>
							) : (
								<a href={pageHref(n)}>{n}</a>
							),
						)}
						{page.url.next && (
							<a href={page.url.next} rel="next">
								<span class="step-label">다음</span> ›
							</a>
						)}
					</nav>
				)
			}
			<AdSlot name="footer" label="하단 디스플레이 광고" size="728×90 / 반응형" />
		</main>
		<Footer />
		<script>
			// 목록 보기: 기본 16편(PC 4열 × 4줄)씩 쪽 번호로 넘기고,
			// '더 보기'는 지금 보기 단위만큼 이어서 보이고, '50개 보기'·'전체 보기'는 보기 단위를 바꾼다.
			// 1쪽(50편)에 없는 글은 다음 쪽 HTML을 가져와 카드만 이어 붙인다(광고 칸은 붙이지 않음).
			// JS가 없으면 이 쪽 50편과 번호 페이지(/blog/page/N/)가 그대로 보인다.
			const ctrl = document.getElementById('list-controls');
			const grid = document.getElementById('post-grid');
			const jsPager = document.getElementById('js-pager');
			if (ctrl && grid && jsPager) {
				const staticPager = document.querySelector<HTMLElement>('nav.pager:not(#js-pager)');
				const moreBtn = ctrl.querySelector<HTMLButtonElement>('[data-act="more"]')!;
				const sizeBtns = Array.from(ctrl.querySelectorAll<HTMLButtonElement>('[data-size]'));
				const total = Number(ctrl.dataset.total) || 0;
				const base = Number(ctrl.dataset.step) || 16;
				let next: string | null = ctrl.dataset.next || null;
				let size = base;
				let start = 0;
				let end = base;
				const items = () => Array.from(grid.querySelectorAll<HTMLElement>(':scope > li.post-item'));
				const ad = grid.querySelector<HTMLElement>(':scope > .ad-card');

				const ensure = async (count: number) => {
					while (items().length < Math.min(count, total) && next) {
						const doc = new DOMParser().parseFromString(await (await fetch(next)).text(), 'text/html');
						doc.querySelectorAll('#post-grid > li.post-item').forEach((li) => grid.append(document.importNode(li, true)));
						next = doc.getElementById('list-controls')?.getAttribute('data-next') || null;
						// 2쪽부터는 list-controls가 없으므로 정적 '다음' 링크로 이어 간다
						if (!next) next = doc.querySelector<HTMLAnchorElement>('nav.pager a[rel="next"]')?.href ?? null;
					}
				};

				const pageButton = (label: string, page: number, current = false) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.textContent = label;
					if (current) {
						b.className = 'current';
						b.setAttribute('aria-current', 'page');
					}
					b.addEventListener('click', () => go((page - 1) * size, page * size, true));
					return b;
				};

				const render = () => {
					const loaded = items();
					loaded.forEach((li, i) => li.classList.toggle('is-hidden', i < start || i >= end));
					// 광고 칸은 8번째 카드가 보일 때만(다른 쪽으로 넘기면 맨 위에 광고만 남지 않게)
					if (ad) ad.classList.toggle('is-hidden', !(start < 8 && end > 8));
					const shown = Math.min(end, total);
					moreBtn.hidden = shown >= total;
					moreBtn.innerHTML = `더 보기 <span class="more-left">(남은 ${total - shown}편)</span>`;
					sizeBtns.forEach((b) => {
						const v = b.dataset.size === 'all' ? Infinity : Number(b.dataset.size);
						b.setAttribute('aria-pressed', String(v === size));
					});
					jsPager.replaceChildren();
					const pages = size === Infinity ? 1 : Math.ceil(total / size);
					jsPager.hidden = pages <= 1;
					if (pages <= 1) return;
					const current = Math.floor(start / size) + 1;
					if (current > 1) jsPager.append(pageButton('‹', current - 1));
					let gap = false;
					for (let n = 1; n <= pages; n++) {
						if (n === 1 || n === pages || Math.abs(n - current) <= 2) {
							jsPager.append(pageButton(String(n), n, n === current));
							gap = false;
						} else if (!gap) {
							const g = document.createElement('span');
							g.className = 'gap';
							g.textContent = '…';
							jsPager.append(g);
							gap = true;
						}
					}
					if (current < pages) jsPager.append(pageButton('›', current + 1));
				};

				const go = async (s: number, e: number, scroll = false) => {
					ctrl.querySelectorAll('button').forEach((b) => (b.disabled = true));
					try {
						await ensure(e);
					} catch {
						// 불러오기 실패: 이미 있는 글만으로 보여 준다
					}
					start = s;
					end = Math.min(e, Math.max(items().length, s + 1));
					ctrl.querySelectorAll('button').forEach((b) => (b.disabled = false));
					render();
					if (scroll) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
				};

				moreBtn.addEventListener('click', () => go(start, end + (size === Infinity ? total : size)));
				sizeBtns.forEach((b) =>
					b.addEventListener('click', () => {
						const v = b.dataset.size === 'all' ? Infinity : Number(b.dataset.size);
						// 이미 선택된 보기를 다시 누르면 기본(16편)으로 돌아간다
						size = v === size ? base : v;
						const s = size === Infinity ? 0 : Math.floor(start / size) * size;
						go(s, size === Infinity ? total : s + size);
					}),
				);

				ctrl.hidden = false;
				if (staticPager) staticPager.style.display = 'none';
				render();
			}
		</script>
	</body>
</html>
