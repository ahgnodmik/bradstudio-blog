---
// 목록 페이지(/blog, 카테고리, 태그)용 카드: 위 썸네일 + 아래 카테고리·제목·요약·날짜.
// 홈 가로 스크롤 줄은 기존 타일형 PostCard를 그대로 쓴다.
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { CATEGORIES } from '../consts';

interface Props {
	post: any;
	// 첫 화면 카드는 lazy 로딩을 끈다
	eager?: boolean;
	// 촘촘한 목록용: 요약 숨기고 글자·여백 축소
	compact?: boolean;
}

const { post, eager = false, compact = false } = Astro.props;
const thumb = post.data.thumbnail;
const category = CATEGORIES[post.data.category as keyof typeof CATEGORIES];
const loading = eager ? 'eager' : 'lazy';
---

<article class:list={['list-card', { compact }]}>
	<div class="thumb">
		{
			thumb ? (
				<img src={thumb.url} width="720" height="405" alt={thumb.alt} loading={loading} />
			) : post.data.heroImage ? (
				<Image width={720} height={405} src={post.data.heroImage} alt="" loading={loading} />
			) : (
				<img src={`/og/${post.data.contentId}.png`} width="720" height="378" alt="" loading={loading} />
			)
		}
	</div>
	<div class="body">
		<p class="top">
			{category && <span class="cat">{category}</span>}
			<FormattedDate date={post.data.updatedDate ?? post.data.pubDate} />
		</p>
		<h3 class="title">
			<a class="card-link" href={`/blog/${post.id}/`}>{post.data.title}</a>
		</h3>
		{!compact && <p class="desc">{post.data.description}</p>}
	</div>
</article>

<style>
	.list-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: #fff;
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}
	.list-card:hover {
		box-shadow: 0 6px 20px rgba(15, 18, 25, 0.1);
		transform: translateY(-2px);
	}
	.list-card:focus-within {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		background: #e9ecf2;
		overflow: hidden;
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.9rem 1rem 1.1rem;
	}
	.top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}
	.top :global(time) {
		color: inherit;
	}
	.cat {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		background: rgba(0, 100, 224, 0.1);
		color: var(--accent);
		font-weight: 700;
	}
	.title {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.45;
		word-break: keep-all;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-link,
	.card-link:hover {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/* 카드 전체를 클릭 영역으로 */
	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.desc {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.55;
		color: rgb(var(--gray-dark));
		word-break: keep-all;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.compact .body {
		gap: 0.35rem;
		padding: 0.6rem 0.7rem 0.75rem;
	}
	.compact .thumb {
		aspect-ratio: 2 / 1;
	}
	.compact .top {
		flex-wrap: wrap;
		font-size: 0.7rem;
		gap: 0.2rem 0.35rem;
	}
	.compact .cat,
	.compact .top :global(time) {
		white-space: nowrap;
	}
	.compact .cat {
		padding: 0.1rem 0.4rem;
	}
	.compact .title {
		font-size: 0.875rem;
		line-height: 1.4;
	}
	.compact:hover {
		transform: none;
	}
</style>
