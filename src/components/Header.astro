---
import { CATEGORIES, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/blog">전체 글</HeaderLink>
			{
				Object.entries(CATEGORIES).map(([key, label]) => (
					<HeaderLink href={`/category/${key}`}>{label}</HeaderLink>
				))
			}
			<HeaderLink href="/about">소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0.75em 1em;
		background: #ffffff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		font-weight: 700;
	}
	h2 a,
	h2 a.active {
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1080px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	nav .internal-links a {
		padding: 0.375rem 0.875rem;
		color: rgb(var(--gray-dark));
		font-size: 0.875rem;
		font-weight: 600;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--rounded-full);
		text-decoration: none;
	}
	nav .internal-links a.active {
		background: rgb(var(--black));
		color: #ffffff;
		border-color: transparent;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}
</style>
