---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { WORKS } from '../data/works';

const career = WORKS.filter((w) => w.details);
const channels = WORKS.filter((w) => !w.details);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`More works | ${SITE_TITLE}`}
			description="Brad Studio 편집자의 다른 작업들 — 운영 채널과 주요 경력을 소개합니다."
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>More works</h1>

			<h2>운영 채널</h2>
			<ul>
				{
					channels.map((w) => (
						<li>
							<a href={w.href} rel="noopener" target="_blank">
								{w.label}
							</a>{' '}
							— Instagram
						</li>
					))
				}
			</ul>

			<h2>주요 경력</h2>
			{
				career.map((w) => (
					<section id={w.slug} class="work">
						<h3>{w.label}</h3>
						<p class="meta">
							{w.period} · {w.role}
						</p>
						<ul>{w.details?.map((d) => <li>{d}</li>)}</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.work {
		margin: 2rem 0;
	}
	.work h3 {
		margin-bottom: 0.25rem;
	}
	.meta {
		margin: 0 0 0.5rem 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
</style>
