---
import BaseHead from '../components/BaseHead.astro';
import SiteJsonLd from '../components/seo/SiteJsonLd.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import AdInFeed from '../components/AdInFeed.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getVisiblePosts } from '../lib/content';
import AdSlot from '../components/AdSlot.astro';

// 카드 11장 + 인피드 광고 1칸 = 12칸 (4·3·2열 모두 딱 맞음)
const posts = (await getVisiblePosts()).slice(0, 11);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<SiteJsonLd />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				box-sizing: border-box;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			/* 카드 한 칸 ≥ 250px 유지(인피드 fluid 광고 최소 폭): 열 간격 12px, 폭에 따라 4→3→2→1열 */
			.post-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.75rem;
				margin-top: 2rem;
			}
			.all-posts {
				display: inline-block;
				margin-top: 2rem;
			}
			@media (max-width: 1079px) {
				.post-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			@media (max-width: 819px) {
				.post-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 600px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_DESCRIPTION}</p>
			<section>
				<h2>최신글</h2>
				<div class="post-grid">
					{posts.map((post, index) => (
						<>
							<PostCard post={post} />
							{index === 3 && <AdInFeed as="div" />}
						</>
					))}
				</div>
				<a class="all-posts" href="/blog/">전체 글 보기 →</a>
			</section>
			<AdSlot name="footer" label="하단 디스플레이 광고" size="728×90 / 반응형" />
		</main>
		<Footer />
	</body>
</html>
