---
import BaseHead from '../components/BaseHead.astro';
import SiteJsonLd from '../components/seo/SiteJsonLd.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import AdInFeed from '../components/AdInFeed.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getVisiblePosts } from '../lib/content';
import AdSlot from '../components/AdSlot.astro';

const allPosts = await getVisiblePosts();
const posts = allPosts.slice(0, 12);

// 카테고리별 가로 스크롤 줄: 카테고리당 최신 12편
const ROW_SIZE = 12;
const rows = Object.entries(CATEGORIES)
	.map(([key, label]) => {
		const inCat = allPosts.filter((p) => p.data.category === key);
		return { key, label, total: inCat.length, posts: inCat.slice(0, ROW_SIZE) };
	})
	.filter((r) => r.total > 0);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<SiteJsonLd />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				box-sizing: border-box;
				margin: 0 auto;
				padding: 1.5rem 1em 3rem;
			}
			.cat-section {
				margin-top: 2rem;
			}
			.cat-section.latest {
				margin-top: 2rem;
			}
			.feed-ad {
				margin-top: 1.5rem;
			}
			.cat-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
			}
			.cat-head h2 {
				margin: 0;
				font-size: 1.1rem;
			}
			.cat-head .count {
				margin-left: 0.4rem;
				font-size: 0.85rem;
				font-weight: 500;
				color: rgb(var(--gray));
			}
			.cat-more {
				flex-shrink: 0;
				font-size: 0.875rem;
				font-weight: 600;
				text-decoration: none;
			}
			/* 가로 스크롤 줄: 스냅 + 다음 카드 일부가 보여 스크롤 가능함을 알림 */
			.cat-row {
				display: grid;
				grid-auto-flow: column;
				grid-auto-columns: 188px;
				gap: 0.625rem;
				margin: 0.75rem -1em 0;
				padding: 0 1em 0.75rem;
				overflow-x: auto;
				overscroll-behavior-x: contain;
				scroll-snap-type: x mandatory;
				scroll-padding: 0 1em;
				list-style: none;
			}
			.cat-row > li {
				scroll-snap-align: start;
			}
			/* 가로 줄 카드는 작게: GUI 요소(배지·제목·메타)도 함께 축소 */
			.cat-row > li :global(.post-card) {
				aspect-ratio: 4 / 5;
				border-radius: 10px;
			}
			.cat-row > li :global(.body) {
				gap: 0.35rem;
				padding: 0.75rem 0.7rem 0.65rem;
			}
			.cat-row > li :global(.cat) {
				padding: 0.12rem 0.45rem;
				font-size: 0.65rem;
			}
			.cat-row > li :global(.title) {
				font-size: 0.86rem;
				line-height: 1.38;
				-webkit-line-clamp: 3;
			}
			.cat-row > li :global(.meta) {
				font-size: 0.64rem;
			}
			.hero h1 {
				margin: 0;
				font-size: 1.5rem;
			}
			.hero p {
				margin: 0.35rem 0 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.cat-row::-webkit-scrollbar {
				height: 6px;
			}
			.cat-row::-webkit-scrollbar-thumb {
				background: rgb(var(--gray-light));
				border-radius: 999px;
			}
			@media (max-width: 600px) {
				.cat-row {
					grid-auto-columns: 42vw;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</div>
			<section class="cat-section latest" aria-labelledby="cat-latest">
				<div class="cat-head">
					<h2 id="cat-latest">최신글</h2>
					<a class="cat-more" href="/blog/">전체 글 →</a>
				</div>
				<ul class="cat-row">
					{posts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			</section>
			<div class="feed-ad">
				<AdInFeed as="div" />
			</div>
			{
				rows.map((row) => (
					<section class="cat-section" aria-labelledby={`cat-${row.key}`}>
						<div class="cat-head">
							<h2 id={`cat-${row.key}`}>
								{row.label}
								<span class="count">{row.total}</span>
							</h2>
							<a class="cat-more" href={`/category/${row.key}/`}>
								더보기 →
							</a>
						</div>
						<ul class="cat-row">
							{row.posts.map((post) => (
								<li>
									<PostCard post={post} />
								</li>
							))}
						</ul>
					</section>
				))
			}
			<AdSlot name="footer" label="하단 디스플레이 광고" size="728×90 / 반응형" />
		</main>
		<Footer />
	</body>
</html>
