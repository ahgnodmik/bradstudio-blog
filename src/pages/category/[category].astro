---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import AdInFeed from '../../components/AdInFeed.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';
import { SERIES } from '../../lib/series';

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	// 글 없는 카테고리는 빈 페이지를 만들지 않는다
	return Object.keys(CATEGORIES).filter((category) => posts.some((post) => post.data.category === category)).map((category) => ({
		params: { category },
		props: { posts: posts.filter((post) => post.data.category === category) },
	}));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = CATEGORIES[category as keyof typeof CATEGORIES];
const seriesHere = Object.values(SERIES).filter((s) => s.category === category);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label} 카테고리 글 목록`} />
	</head>
	<body>
		<Header />
		<main>
			<div class="layout">
				<section class="posts">
					<h1>{label}</h1>
					{seriesHere.map((s) => (
						<a class="series-banner" href={`/series/${s.id}/`}>
							<small>연재</small>
							<strong>{s.title}</strong>
							<span>{s.subtitle} · 전체 목차 보기 →</span>
						</a>
					))}
					{posts.length === 0 && <p>아직 글이 없습니다.</p>}
					<div class="post-grid">
						{posts.map((post, index) => (
							<>
								<PostCard post={post} />
								{(index + 1) % 8 === 4 && index < posts.length - 1 && <AdInFeed as="div" />}
							</>
						))}
					</div>
				</section>
				<Sidebar />
			</div>
		</main>
		<Footer />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				box-sizing: border-box;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			.series-banner {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				margin: 0 0 1.5rem;
				padding: 1rem 1.1rem;
				border-radius: 14px;
				background: #f8f6f2;
				border: 1px solid rgb(var(--gray-light));
				text-decoration: none;
				color: rgb(var(--gray-dark));
			}
			.series-banner small {
				font-size: 0.75rem;
				color: #b07a3c;
				font-weight: 700;
			}
			.series-banner strong {
				color: rgb(var(--black));
				font-size: 1.1rem;
			}
			.layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}
			.posts {
				flex: 1;
				min-width: 0;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 1rem;
			}
			li a {
				display: block;
				text-decoration: none;
				color: rgb(var(--black));
				font-size: 1.1rem;
			}
			li a:hover {
				color: var(--accent);
			}
			.date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 960px) {
				.layout {
					flex-direction: column;
				}
			}
			.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin-top: 1rem;
	}
	@media (max-width: 600px) {
		.post-grid { grid-template-columns: 1fr; }
	}
</style>
	</body>
</html>
