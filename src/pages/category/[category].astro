---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return Object.keys(CATEGORIES).map((category) => ({
		params: { category },
		props: { posts: posts.filter((post) => post.data.category === category) },
	}));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = CATEGORIES[category as keyof typeof CATEGORIES];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label} 카테고리 글 목록`} />
	</head>
	<body>
		<Header />
		<main>
			<div class="layout">
				<section class="posts">
					<h1>{label}</h1>
					{posts.length === 0 && <p>아직 글이 없습니다.</p>}
					<div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
				</section>
				<Sidebar />
			</div>
		</main>
		<Footer />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			.layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}
			.posts {
				flex: 1;
				min-width: 0;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 1rem;
			}
			li a {
				display: block;
				text-decoration: none;
				color: rgb(var(--black));
				font-size: 1.1rem;
			}
			li a:hover {
				color: var(--accent);
			}
			.date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 960px) {
				.layout {
					flex-direction: column;
				}
			}
			.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem 1.5rem;
		margin-top: 1rem;
	}
	@media (max-width: 600px) {
		.post-grid { grid-template-columns: 1fr; }
	}
</style>
	</body>
</html>
