---
import { Image } from 'astro:assets';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import AdInFeed from '../../components/AdInFeed.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const posts = await getVisiblePosts();
	return paginate(posts, { pageSize: 6 });
}

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
// 카드 4번째 뒤에 In-feed 광고 삽입
const AD_AFTER = 4;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			.layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}
			.posts {
				flex: 1;
				min-width: 0;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.5rem;
				margin-top: 2.5rem;
			}
			.pagination a,
			.pagination span {
				padding: 0.375rem 0.875rem;
				font-size: 0.875rem;
				font-weight: 600;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-full);
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.pagination .current {
				background: rgb(var(--black));
				color: #ffffff;
				border-color: transparent;
			}
			.pagination .disabled {
				color: rgb(var(--gray-light));
			}
			@media (max-width: 960px) {
				.layout {
					flex-direction: column;
				}
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="layout">
				<section class="posts">
					<ul>
						{
							page.data.map((post, index) => (
								<>
									<li>
										<a href={`/blog/${post.id}/`}>
											{post.data.heroImage ? (
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											) : (
												<img
													src={`/og/${post.data.contentId}.png`}
													width="720"
													height="378"
													alt=""
													loading="lazy"
												/>
											)}
											<h4 class="title">{post.data.title}</h4>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</a>
									</li>
									{index === AD_AFTER - 1 && <AdInFeed />}
								</>
							))
						}
					</ul>
					{
						page.lastPage > 1 && (
							<nav class="pagination" aria-label="페이지 이동">
								{page.url.prev ? <a href={page.url.prev}>← 이전</a> : <span class="disabled">← 이전</span>}
								{Array.from({ length: page.lastPage }, (_, i) => {
									const num = i + 1;
									const href = num === 1 ? '/blog/' : `/blog/${num}/`;
									return num === page.currentPage ? (
										<span class="current">{num}</span>
									) : (
										<a href={href}>{num}</a>
									);
								})}
								{page.url.next ? <a href={page.url.next}>다음 →</a> : <span class="disabled">다음 →</span>}
							</nav>
						)
					}
				</section>
				<Sidebar />
			</div>
			<AdSlot name="footer" label="하단 디스플레이 광고" />
		</main>
		<Footer />
	</body>
</html>
