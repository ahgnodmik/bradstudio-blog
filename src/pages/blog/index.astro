---
import PostListPage from '../../components/PostListPage.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';

// 1쪽. 2쪽부터는 /blog/page/N/
const posts = await getVisiblePosts();
const page = {
	data: posts.slice(0, POSTS_PER_PAGE),
	start: 0,
	end: Math.min(POSTS_PER_PAGE, posts.length) - 1,
	size: POSTS_PER_PAGE,
	total: posts.length,
	currentPage: 1,
	lastPage: Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE)),
	url: {
		current: '/blog/',
		prev: undefined,
		next: posts.length > POSTS_PER_PAGE ? '/blog/page/2/' : undefined,
		first: undefined,
		last: undefined,
	},
};
---

<PostListPage page={page as any} />
