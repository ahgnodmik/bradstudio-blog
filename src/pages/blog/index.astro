---
import { Image } from 'astro:assets';
import AdInFeed from '../../components/AdInFeed.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';

const posts = await getVisiblePosts();

// 처음 보이는 개수·더 보기 클릭당 추가 개수
const PAGE_SIZE = 6;
// In-feed 광고는 4번째 카드 뒤
const AD_AFTER = 4;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			.layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}
			.posts {
				flex: 1;
				min-width: 0;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li.post-hidden {
				display: none;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.load-more-wrap {
				display: flex;
				justify-content: center;
				margin-top: 2.5rem;
			}
			.load-more {
				padding: 0.625rem 2rem;
				font-size: 0.9375rem;
				font-weight: 700;
				color: rgb(var(--black));
				background: #ffffff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-full);
				cursor: pointer;
			}
			.load-more:hover {
				background: rgb(var(--black));
				color: #ffffff;
				border-color: transparent;
			}
			@media (max-width: 960px) {
				.layout {
					flex-direction: column;
				}
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="layout">
				<section class="posts">
					<ul id="post-list">
						{
							posts.map((post, index) => (
								<>
									<li class:list={['post-item', { 'post-hidden': index >= PAGE_SIZE }]}>
										<a href={`/blog/${post.id}/`}>
											{post.data.heroImage ? (
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											) : (
												<img
													src={`/og/${post.data.contentId}.png`}
													width="720"
													height="378"
													alt=""
													loading="lazy"
												/>
											)}
											<h4 class="title">{post.data.title}</h4>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</a>
									</li>
									{index === AD_AFTER - 1 && <AdInFeed />}
								</>
							))
						}
					</ul>
					{
						posts.length > PAGE_SIZE && (
							<div class="load-more-wrap">
								<button class="load-more" id="load-more" data-page-size={PAGE_SIZE}>
									더 불러오기
								</button>
							</div>
						)
					}
				</section>
				<Sidebar />
			</div>
			<AdSlot name="footer" label="하단 디스플레이 광고" />
		</main>
		<Footer />
		<script>
			const button = document.getElementById('load-more');
			if (button) {
				const pageSize = Number(button.dataset.pageSize ?? 6);
				button.addEventListener('click', () => {
					const hidden = document.querySelectorAll('#post-list .post-item.post-hidden');
					hidden.forEach((li, i) => {
						if (i < pageSize) li.classList.remove('post-hidden');
					});
					if (hidden.length <= pageSize) button.parentElement?.remove();
				});
			}
		</script>
	</body>
</html>
