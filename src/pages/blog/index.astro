---
import AdInFeed from '../../components/AdInFeed.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getVisiblePosts } from '../../lib/content';

const posts = await getVisiblePosts();

// 처음 보이는 개수 (4열 × 3행)
const PAGE_SIZE = 12;
// 더 보기 드랍다운 옵션 (클릭당 추가 개수)
const LOAD_OPTIONS = [10, 30, 50, 100];
// In-feed 광고는 4번째 카드 뒤
const AD_AFTER = 4;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 2rem 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li.post-hidden {
				display: none;
			}
			ul :global(li.ad-card) {
				grid-column: 1 / -1;
			}
			.load-more-wrap {
				display: flex;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 2.5rem;
			}
			.load-more {
				padding: 0.625rem 2rem;
				font-size: 0.9375rem;
				font-weight: 700;
				color: rgb(var(--black));
				background: #ffffff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-full);
				cursor: pointer;
			}
			.load-more:hover {
				background: rgb(var(--black));
				color: #ffffff;
				border-color: transparent;
			}
			.load-count {
				padding: 0.5rem 0.75rem;
				font-size: 0.875rem;
				color: rgb(var(--black));
				background: #ffffff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-full);
				cursor: pointer;
			}
			@media (max-width: 768px) {
				ul {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 600px) {
				ul {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="posts">
				<ul id="post-list">
					{
						posts.map((post, index) => (
							<>
								<li class:list={['post-item', { 'post-hidden': index >= PAGE_SIZE }]}>
									<PostCard post={post} />
								</li>
								{index === AD_AFTER - 1 && <AdInFeed />}
							</>
						))
					}
				</ul>
				{
					posts.length > PAGE_SIZE && (
						<div class="load-more-wrap">
							<button class="load-more" id="load-more">
								더 보기
							</button>
							<select class="load-count" id="load-count" aria-label="한 번에 불러올 글 수">
								{LOAD_OPTIONS.map((n) => (
									<option value={n}>{n}개씩</option>
								))}
							</select>
						</div>
					)
				}
			</section>
			<AdSlot name="footer" label="하단 디스플레이 광고" />
		</main>
		<Footer />
		<script>
			const button = document.getElementById('load-more');
			const select = document.getElementById('load-count') as HTMLSelectElement | null;
			if (button && select) {
				button.addEventListener('click', () => {
					const count = Number(select.value);
					const hidden = document.querySelectorAll('#post-list .post-item.post-hidden');
					hidden.forEach((li, i) => {
						if (i < count) li.classList.remove('post-hidden');
					});
					if (hidden.length <= count) button.parentElement?.remove();
				});
			}
		</script>
	</body>
</html>
