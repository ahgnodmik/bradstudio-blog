---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const tools = [
	{
		href: '/tools/char-count/',
		name: '글자수 세기',
		desc: '공백 포함·제외, 바이트(한글 2·UTF-8), 원고지 매수를 한 번에. 목표 글자수까지 남은 양 표시.',
		tag: '글쓰기',
	},
	{
		href: '/tools/electricity-bill/',
		name: '전기요금 누진제 계산기',
		desc: '평소 사용량에 가전을 더하면 누진 구간과 청구액이 얼마나 바뀌는지 계산.',
		tag: '생활비',
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`도구 | ${SITE_TITLE}`} description="Brad Studio가 직접 만든 무료 생활 도구 모음: 글자수 세기, 전기요금 누진제 계산기." />
	</head>
	<body>
		<Header />
		<main>
			<h1>도구</h1>
			<p>설치 없이 브라우저에서 바로 쓰는 도구입니다. 입력값은 서버로 보내지 않고, 계산 기준과 출처를 각 페이지 아래에 공개합니다.</p>
			<ul class="tools">
				{
					tools.map((t) => (
						<li>
							<a href={t.href}>
								<span class="tag">{t.tag}</span>
								<strong>{t.name}</strong>
								<span class="desc">{t.desc}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tools {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.tools a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		box-sizing: border-box;
		padding: 1.1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--rounded-xl);
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.tools a:hover {
		border-color: var(--accent);
	}
	.tools strong {
		font-size: 1.1rem;
		color: rgb(var(--black));
	}
	.tag {
		align-self: flex-start;
		padding: 0.1rem 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent);
		background: #eaf2ff;
		border-radius: 999px;
	}
	.desc {
		font-size: 0.9rem;
	}
	@media (max-width: 600px) {
		.tools {
			grid-template-columns: 1fr;
		}
	}
</style>
