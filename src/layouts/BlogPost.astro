---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Sidebar from '../components/Sidebar.astro';

type Props = CollectionEntry<'blog'>['data'];

const post = Astro.props;
const { title, description, pubDate, updatedDate, heroImage } = post;
// 미발행 글은 preview 빌드에 포함되더라도 검색엔진에서 제외
const noindex = post.seo.noindex || post.status !== 'published';
// OG 이미지 우선순위: seo.ogImage > heroImage > 자동 생성 썸네일
const ogImage = post.seo.ogImage ?? heroImage ?? `/og/${post.contentId}.png`;
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={ogImage}
			noindex={noindex}
			canonical={post.seo.canonical}
			article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
		/>
		<JsonLd post={post} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}
			.layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}
			article {
				flex: 1;
				min-width: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				max-width: 100%;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.faq {
				margin-top: 2rem;
			}
			.faq details {
				margin-bottom: 0.75rem;
				padding: 0.75rem 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-xl);
			}
			.faq summary {
				cursor: pointer;
				font-weight: 700;
			}
			.faq details p {
				margin: 0.75rem 0 0 0;
			}
			.sources {
				margin-top: 2rem;
				padding: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--rounded-xl);
				font-size: 0.875rem;
			}
			.sources h2 {
				margin: 0 0 0.75rem 0;
				font-size: 1.1rem;
			}
			.sources ul {
				margin: 0;
				padding-left: 1.25rem;
			}
			.sources li {
				margin-bottom: 0.5rem;
			}
			.sources .accessed {
				margin-left: 0.5rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 960px) {
				.layout {
					flex-direction: column;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout">
				<article>
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<AdSlot name="postTop" label="본문 상단 광고" />
					{post.monetization.affiliateDisclosure && <AffiliateDisclosure />}
					<div class="prose">
						<slot />
					</div>
					{
						post.faq.length > 0 && (
							<section class="faq">
								<h2>자주 묻는 질문</h2>
								{post.faq.map((item) => (
									<details>
										<summary>{item.question}</summary>
										<p>{item.answer}</p>
									</details>
								))}
							</section>
						)
					}
					{
						post.sources.length > 0 && (
							<section class="sources">
								<h2>참고 자료·출처</h2>
								<ul>
									{post.sources.map((source) => (
										<li>
											<a href={source.url} target="_blank" rel="noopener nofollow">
												{source.title}
											</a>
											<span class="accessed">
												(확인일: <FormattedDate date={source.accessedAt} />)
											</span>
										</li>
									))}
								</ul>
							</section>
						)
					}
					<RelatedPosts contentIds={post.internalLinks} />
					<AdSlot name="postBottom" label="본문 하단 광고" />
				</article>
				<Sidebar />
			</div>
			<AdSlot name="footer" label="하단 디스플레이 광고" />
		</main>
		<Footer />
	</body>
</html>
