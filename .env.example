# Blogger cross-posting (content-ops/scripts/post-to-blogger.mjs)
# Google Cloud console: OAuth client (Desktop app), Blogger API v3 enabled
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
# obtained via: node content-ops/scripts/post-to-blogger.mjs --auth
BLOGGER_REFRESH_TOKEN=
# optional overrides
# BLOGGER_BLOG_URL=https://mitssum.blogspot.com
# BLOGGER_BLOG_ID=

# Google Tag Manager (src/components/Analytics.astro)
# when set, GTM replaces the direct gtag snippet in BaseHead.astro
PUBLIC_GTM_ID=
